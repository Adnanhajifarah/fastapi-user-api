# Copy to .env and fill in. .env is gitignored - never commit real values.

# --- Database ---
DB_NAME=fast_apidb
DB_USER=adn
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_POOL_MIN=1
DB_POOL_MAX=10

# --- Auth ---
# Set APP_ENV=production and the app refuses to start without a real secret.
APP_ENV=development
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=30

# --- TMDB (catalog ingestion) ---
# Free key: https://www.themoviedb.org/settings/api
# Works with either a v3 API key or a v4 read access token.
TMDB_API_KEY=
